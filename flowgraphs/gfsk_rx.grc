# ===================== FRAME SYNC =====================
- name: epy_block_frame_sync
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nimport sys\nfrom gnuradio import gr\n\nclass frame_sync(gr.basic_block):\n\
      \    \"\"\"Finds ASM 0xD87112BD — outputs frames to queue, drains to output.\"\
      \"\"\n    def __init__(self, frame_nbits=4080, threshold=10):\n        gr.basic_block.__init__(self,\n\
      \            name='Frame Sync',\n            in_sig=[np.float32],\n          \
      \  out_sig=[np.float32])\n        asm_str = '11011000011100010001001010111101'\n\
      \        self.asm_bits = np.array([int(b) for b in asm_str], dtype=np.uint8)\n\
      \        self.asm_inv = 1 - self.asm_bits\n        self.asm_len = 32\n       \
      \ self.frame_nbits = frame_nbits\n        self.threshold = threshold\n       \
      \ self.packet_len = self.asm_len + self.frame_nbits\n        self.inbuf = np.array([],\
      \ dtype=np.float32)\n        self.outqueue = np.array([], dtype=np.float32)\n\
      \        self.frames_found = 0\n        self.log = open('C:/gfsk/frame_sync_log.txt',\
      \ 'w')\n        self.log.write('Frame sync v2 started\\n')\n        self.log.flush()\n\
      \n    def forecast(self, noutput_items, ninputs):\n        if len(self.outqueue)\
      \ > 0:\n            return [0]\n        return [self.packet_len]\n\n    def general_work(self,\
      \ input_items, output_items):\n        inp = input_items[0]\n        out = output_items[0]\n\
      \        self.inbuf = np.concatenate([self.inbuf, inp])\n        self.consume(0,\
      \ len(inp))\n        if len(self.inbuf) > 500000:\n            self.inbuf = self.inbuf[-self.packet_len*4:]\n\
      \        while len(self.inbuf) >= self.packet_len:\n            hard = (self.inbuf[:self.asm_len]\
      \ > 0).astype(np.uint8)\n            score_n = int(np.sum(hard == self.asm_bits))\n\
      \            score_i = int(np.sum(hard == self.asm_inv))\n            if score_n\
      \ >= self.asm_len - self.threshold:\n                frame = self.inbuf[self.asm_len:self.asm_len+self.frame_nbits].copy()\n\
      \                self.outqueue = np.concatenate([self.outqueue, frame])\n    \
      \            self.inbuf = self.inbuf[self.packet_len:]\n                self.frames_found\
      \ += 1\n                self.log.write(f'FOUND #{self.frames_found} normal score={score_n}\
      \ outq={len(self.outqueue)}\\n')\n                self.log.flush()\n         \
      \   elif score_i >= self.asm_len - self.threshold:\n                frame = -self.inbuf[self.asm_len:self.asm_len+self.frame_nbits].copy()\n\
      \                self.outqueue = np.concatenate([self.outqueue, frame])\n    \
      \            self.inbuf = self.inbuf[self.packet_len:]\n                self.frames_found\
      \ += 1\n                self.log.write(f'FOUND #{self.frames_found} inverted\
      \ score={score_i} outq={len(self.outqueue)}\\n')\n                self.log.flush()\n\
      \            else:\n                self.inbuf = self.inbuf[1:]\n            \
      \    break\n        n_out = min(len(self.outqueue), len(out))\n        if n_out\
      \ > 0:\n            out[:n_out] = self.outqueue[:n_out]\n            self.outqueue\
      \ = self.outqueue[n_out:]\n        return int(n_out)\n"
    affinity: ''
    alias: ''
    comment: 'Finds ASM 0xD87112BD, threshold=10 bit errors allowed'
    maxoutbuf: '0'
    minoutbuf: '0'
    frame_nbits: encoded_frame_bits
    threshold: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 380.0]
    rotation: 0
    state: enabled

