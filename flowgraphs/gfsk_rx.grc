# ===================== RS DECODER =====================
- name: epy_block_rs_decode
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass rs_decode(gr.basic_block):\n\
      \    \"\"\"RS(255,223) decoder. Skips 4 tail bytes, extracts 223 data bytes.\"\
      \"\"\n    def __init__(self):\n        gr.basic_block.__init__(self,\n       \
      \     name='RS(255,223) Decode',\n            in_sig=[np.uint8],\n          \
      \  out_sig=[np.uint8])\n        self.rs_total = 255\n        self.rs_data =\
      \ 223\n        self.tail = 4\n        self.buf = np.array([], dtype=np.uint8)\n\
      \n    def forecast(self, noutput_items, ninputs):\n        n_frames = max(1,\
      \ noutput_items // self.rs_data)\n        return [n_frames * self.rs_total]\n\
      \n    def general_work(self, input_items, output_items):\n        inp = input_items[0]\n\
      \        out = output_items[0]\n        self.buf = np.concatenate([self.buf,\
      \ inp])\n        self.consume(0, len(inp))\n        out_idx = 0\n        while\
      \ len(self.buf) >= self.rs_total and out_idx + self.rs_data <= len(out):\n  \
      \          frame = self.buf[:self.rs_total]\n            self.buf = self.buf[self.rs_total:]\n\
      \            out[out_idx:out_idx+self.rs_data] = frame[self.tail:self.tail+self.rs_data]\n\
      \            out_idx += self.rs_data\n        return out_idx\n"
    affinity: ''
    alias: ''
    comment: 'Strips tail + parity, outputs 223 data bytes per frame'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1040, 392.0]
    rotation: 0
    state: enabled

