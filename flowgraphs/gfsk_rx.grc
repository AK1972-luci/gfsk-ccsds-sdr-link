connections:
# Main signal chain: HackRF → Rotator(+100kHz) → LPF(decim) → Quad Demod → DC Blocker → Symbol Sync → Frame Sync → Decode → File
- [osmosdr_source_0, '0', blocks_rotator_cc_0, '0']
- [blocks_rotator_cc_0, '0', low_pass_filter_0, '0']
- [low_pass_filter_0, '0', analog_quadrature_demod_cf_0, '0']
- [analog_quadrature_demod_cf_0, '0', dc_blocker_xx_0, '0']
- [dc_blocker_xx_0, '0', digital_symbol_sync_xx_0, '0']
- [digital_symbol_sync_xx_0, '0', epy_block_frame_sync, '0']
- [epy_block_frame_sync, '0', fec_decode_ccsds_27_fb_0, '0']
- [fec_decode_ccsds_27_fb_0, '0', epy_block_rs_decode, '0']
- [epy_block_rs_decode, '0', blocks_file_sink_0, '0']
# Visualization
- [digital_symbol_sync_xx_0, '0', digital_binary_slicer_fb_0, '0']
- [digital_binary_slicer_fb_0, '0', blocks_char_to_float_1, '0']
- [blocks_char_to_float_1, '0', qtgui_time_sink_x_0, '0']
- [dc_blocker_xx_0, '0', qtgui_time_sink_x_1, '0']
- [digital_binary_slicer_fb_0, '0', blocks_file_sink_1, '0']
- [osmosdr_source_0, '0', qtgui_freq_sink_x_0, '0']
- [osmosdr_source_0, '0', qtgui_waterfall_sink_x_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
