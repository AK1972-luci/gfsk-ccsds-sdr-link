# ===================== FREQUENCY SHIFT (move signal from -100kHz to 0) =====================
- name: blocks_rotator_cc_0
  id: blocks_rotator_cc
  parameters:
    affinity: ''
    alias: ''
    comment: 'Shift signal from -100kHz to baseband — avoids HackRF DC spike'
    maxoutbuf: '0'
    minoutbuf: '0'
    phase_inc: 2*math.pi*100000/samp_rate
    tag_inc_update: 'False'
  states:
