# ===================== FEC ENCODING =====================
- name: blocks_stream_to_vector_0
  id: blocks_stream_to_vector
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: '223'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 232.0]
    rotation: 0
    state: enabled
- name: epy_block_rs_encode
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n# Minimal CCSDS RS(255,223)\
      \ encoder using ccsds_rs_encode\ntry:\n    from satellites import ccsds_rs\n\
      \    HAS_SATELLITES = True\nexcept ImportError:\n    HAS_SATELLITES = False\n\
      \nGF_EXP = None\nGF_LOG = None\nGEN_POLY = None\n\ndef _init_gf():\n    global\
      \ GF_EXP, GF_LOG, GEN_POLY\n    if GF_EXP is not None:\n        return\n   \
      \ GF_EXP = [0] * 512\n    GF_LOG = [0] * 256\n    x = 1\n    for i in range(255):\n\
      \        GF_EXP[i] = x\n        GF_LOG[x] = i\n        x <<= 1\n        if\
      \ x & 0x100:\n            x ^= 0x187  # CCSDS polynomial x^8+x^7+x^2+x+1\n\
      \    for i in range(255, 512):\n        GF_EXP[i] = GF_EXP[i - 255]\n    #\
      \ Build generator polynomial for t=16 (32 parity symbols)\n    # roots are alpha^(112+i)\
      \ for i in 0..31  (CCSDS dual-basis)\n    GEN_POLY = [0] * 33\n    GEN_POLY[0]\
      \ = 1\n    for i in range(32):\n        root = GF_EXP[112 + i]\n        for\
      \ j in range(i + 1, 0, -1):\n            if GEN_POLY[j - 1] != 0:\n       \
      \         GEN_POLY[j] ^= GF_EXP[(GF_LOG[GEN_POLY[j - 1]] + GF_LOG[root]) %\
      \ 255]\n            else:\n                GEN_POLY[j] = GEN_POLY[j]\n      \
      \  GEN_POLY[0] = GF_EXP[(GF_LOG[GEN_POLY[0]] + GF_LOG[root]) % 255]\n\ndef\
      \ _gf_mul(a, b):\n    if a == 0 or b == 0:\n        return 0\n    return GF_EXP[GF_LOG[a]\
      \ + GF_LOG[b]]\n\n# CCSDS dual-basis lookup tables\nBERLEKAMP_TO_CONVENTIONAL\
      \ = [\n    0x00,0x7b,0x09,0x72,0x12,0x69,0x1b,0x60,0x24,0x5f,0x2d,0x56,0x36,0x4d,0x3f,0x44,\n\
      \    0x48,0x33,0x41,0x3a,0x5a,0x21,0x53,0x28,0x6c,0x17,0x65,0x1e,0x7e,0x05,0x77,0x0c,\n\
      \    0x90,0xeb,0x99,0xe2,0x82,0xf9,0x8b,0xf0,0xb4,0xcf,0xbd,0xc6,0xa6,0xdd,0xaf,0xd4,\n\
      \    0xd8,0xa3,0xd1,0xaa,0xca,0xb1,0xc3,0xb8,0xfc,0x87,0xf5,0x8e,0xee,0x95,0xe7,0x9c,\n\
      \    0xf6,0x8d,0xff,0x84,0xe4,0x9f,0xed,0x96,0xd2,0xa9,0xdb,0xa0,0xc0,0xbb,0xc9,0xb2,\n\
      \    0xbe,0xc5,0xb7,0xcc,0xac,0xd7,0xa5,0xde,0x9a,0xe1,0x93,0xe8,0x88,0xf3,0x81,0xfa,\n\
      \    0x66,0x1d,0x6f,0x14,0x74,0x0f,0x7d,0x06,0x42,0x39,0x4b,0x30,0x50,0x2b,0x59,0x22,\n\
      \    0x2e,0x55,0x27,0x5c,0x3c,0x47,0x35,0x4e,0x0a,0x71,0x03,0x78,0x18,0x63,0x11,0x6a,\n\
      \    0x31,0x4a,0x38,0x43,0x23,0x58,0x2a,0x51,0x15,0x6e,0x1c,0x67,0x07,0x7c,0x0e,0x75,\n\
      \    0x79,0x02,0x70,0x0b,0x6b,0x10,0x62,0x19,0x5d,0x26,0x54,0x2f,0x4f,0x34,0x46,0x3d,\n\
      \    0xa1,0xda,0xa8,0xd3,0xb3,0xc8,0xba,0xc1,0x85,0xfe,0x8c,0xf7,0x97,0xec,0x9e,0xe5,\n\
      \    0xe9,0x92,0xe0,0x9b,0xfb,0x80,0xf2,0x89,0xcd,0xb6,0xc4,0xbf,0xdf,0xa4,0xd6,0xad,\n\
      \    0xc7,0xbc,0xce,0xb5,0xd5,0xae,0xdc,0xa7,0xe3,0x98,0xea,0x91,0xf1,0x8a,0xf8,0x83,\n\
      \    0x8f,0xf4,0x86,0xfd,0x9d,0xe6,0x94,0xef,0xab,0xd0,0xa2,0xd9,0xb9,0xc2,0xb0,0xcb,\n\
      \    0x57,0x2c,0x5e,0x25,0x45,0x3e,0x4c,0x37,0x73,0x08,0x7a,0x01,0x61,0x1a,0x68,0x13,\n\
      \    0x1f,0x64,0x16,0x6d,0x0d,0x76,0x04,0x7f,0x3b,0x40,0x32,0x49,0x29,0x52,0x20,0x5b\n\
      ]\nCONVENTIONAL_TO_BERLEKAMP = [0] * 256\nfor _i in range(256):\n    CONVENTIONAL_TO_BERLEKAMP[BERLEKAMP_TO_CONVENTIONAL[_i]]\
      \ = _i\n\ndef _rs_encode_ccsds(data_223):\n    \"\"\"Encode 223 bytes with CCSDS\
      \ RS(255,223). Returns 255 bytes.\"\"\"\n    _init_gf()\n    # Convert from\
      \ conventional to dual basis\n    conv_data = [CONVENTIONAL_TO_BERLEKAMP[b] for\
      \ b in data_223]\n    # Compute parity in dual basis\n    parity = [0] * 32\n\
      \    for i in range(223):\n        feedback = conv_data[i] ^ parity[0]\n    \
      \    for j in range(31):\n            if GEN_POLY[31 - j] != 0 and feedback !=\
      \ 0:\n                parity[j] = parity[j + 1] ^ GF_EXP[GF_LOG[GEN_POLY[31\
      \ - j]] + GF_LOG[feedback]]\n            else:\n                parity[j] = parity[j\
      \ + 1]\n        if GEN_POLY[0] != 0 and feedback != 0:\n            parity[31]\
      \ = GF_EXP[GF_LOG[GEN_POLY[0]] + GF_LOG[feedback]]\n        else:\n        \
      \    parity[31] = 0\n    # Convert parity back to conventional basis\n    parity_conv\
      \ = [BERLEKAMP_TO_CONVENTIONAL[p] for p in parity]\n    return list(data_223)\
      \ + parity_conv\n\nclass rs_encode_vector(gr.basic_block):\n    \"\"\"RS(255,223)\
      \ CCSDS encoder: takes 223-byte vectors, outputs 255-byte vectors.\n    Uses\
      \ gr-satellites if available, otherwise pure-Python fallback.\"\"\"\n    def __init__(self):\n\
      \        gr.basic_block.__init__(self,\n            name='RS Encode CCSDS',\n\
      \            in_sig=[(np.uint8, 223)],\n            out_sig=[(np.uint8, 255)])\n\
      \n    def general_work(self, input_items, output_items):\n        n = min(len(input_items[0]),\
      \ len(output_items[0]))\n        if n == 0:\n            return 0\n        for\
      \ i in range(n):\n            data = input_items[0][i].tolist()\n            if\
      \ HAS_SATELLITES:\n                encoded = list(data) + [0]*32\n           \
      \     ccsds_rs.encode(encoded)\n                output_items[0][i] = np.array(encoded,\
      \ dtype=np.uint8)\n            else:\n                output_items[0][i] = np.array(_rs_encode_ccsds(data),\
      \ dtype=np.uint8)\n        self.consume(0, n)\n        return n\n"
    affinity: ''
    alias: ''
    comment: 'RS(255,223) — adds 32 parity bytes (no external dependency)'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [496, 220.0]
    rotation: 0
    state: enabled
