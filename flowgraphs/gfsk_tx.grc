# ===================== ASM PREPEND (Embedded Python) =====================
- name: epy_block_asm_prepend
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass asm_prepend(gr.basic_block):\n\
      \    \"\"\"Prepends CCSDS ASM (0x1ACFFC1D) to every frame_len-byte frame.\"\"\
      \"\n    def __init__(self, frame_len=510):\n        gr.basic_block.__init__(self,\n\
      \            name='ASM Prepend',\n            in_sig=[np.uint8],\n           \
      \ out_sig=[np.uint8])\n        self.frame_len = frame_len\n        self.asm\
      \ = np.array([0xD8, 0x71, 0x12, 0xBD], dtype=np.uint8)\n\n    def forecast(self,\
      \ noutput_items, ninputs):\n        n_frames = max(1, noutput_items // (self.frame_len\
      \ + 4))\n        return [n_frames * self.frame_len]\n\n    def general_work(self,\
      \ input_items, output_items):\n        inp = input_items[0]\n        out = output_items[0]\n\
      \        n_frames = min(len(inp) // self.frame_len, len(out) // (self.frame_len\
      \ + 4))\n        if n_frames == 0:\n            return 0\n        idx_out =\
      \ 0\n        for i in range(n_frames):\n            out[idx_out:idx_out+4] =\
      \ self.asm\n            idx_out += 4\n            start = i * self.frame_len\n\
      \            out[idx_out:idx_out+self.frame_len] = inp[start:start+self.frame_len]\n\
      \            idx_out += self.frame_len\n        self.consume(0, n_frames * self.frame_len)\n\
      \        return idx_out\n"
    affinity: ''
    alias: ''
    comment: 'Prepends 4-byte custom ASM (0xD87112BD) to every 510-byte encoded frame'
    maxoutbuf: '0'
    minoutbuf: '0'
    frame_len: encoded_frame_len
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 380.0]
    rotation: 0
    state: enabled

