connections:
# Data source → FEC encoding
- [blocks_vector_source_x_0, '0', blocks_stream_to_vector_0, '0']
- [blocks_stream_to_vector_0, '0', epy_block_rs_encode, '0']
- [epy_block_rs_encode, '0', blocks_vector_to_stream_0, '0']
- [blocks_vector_to_stream_0, '0', fec_encode_ccsds_27_bb_0, '0']
- [fec_encode_ccsds_27_bb_0, '0', blocks_pack_k_bits_bb_0, '0']
# ASM prepend → modulate → transmit
- [blocks_pack_k_bits_bb_0, '0', epy_block_asm_prepend, '0']
- [epy_block_asm_prepend, '0', digital_gfsk_mod_0, '0']
- [digital_gfsk_mod_0, '0', uhd_usrp_sink_0, '0']
- [digital_gfsk_mod_0, '0', qtgui_freq_sink_x_0, '0']

